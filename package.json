{
  "name": "@lpm.dev/neo.react-forms",
  "version": "1.0.0",
  "description": "Typed React form state with field subscriptions, validators, and an optional Zod adapter",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./validators": {
      "import": {
        "types": "./dist/validators/index.d.ts",
        "default": "./dist/validators/index.js"
      },
      "require": {
        "types": "./dist/validators/index.d.cts",
        "default": "./dist/validators/index.cjs"
      }
    },
    "./validators/string": {
      "import": {
        "types": "./dist/validators/string.d.ts",
        "default": "./dist/validators/string.js"
      },
      "require": {
        "types": "./dist/validators/string.d.cts",
        "default": "./dist/validators/string.cjs"
      }
    },
    "./validators/number": {
      "import": {
        "types": "./dist/validators/number.d.ts",
        "default": "./dist/validators/number.js"
      },
      "require": {
        "types": "./dist/validators/number.d.cts",
        "default": "./dist/validators/number.cjs"
      }
    },
    "./validators/compose": {
      "import": {
        "types": "./dist/validators/compose.d.ts",
        "default": "./dist/validators/compose.js"
      },
      "require": {
        "types": "./dist/validators/compose.d.cts",
        "default": "./dist/validators/compose.cjs"
      }
    },
    "./adapters": {
      "import": {
        "types": "./dist/adapters/index.d.ts",
        "default": "./dist/adapters/index.js"
      },
      "require": {
        "types": "./dist/adapters/index.d.cts",
        "default": "./dist/adapters/index.cjs"
      }
    },
    "./devtools": {
      "import": {
        "types": "./dist/devtools/index.d.ts",
        "default": "./dist/devtools/index.js"
      },
      "require": {
        "types": "./dist/devtools/index.d.cts",
        "default": "./dist/devtools/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    ".lpm",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:memory": "node --expose-gc ./node_modules/vitest/vitest.mjs run test/benchmarks/memory-leak.test.ts --pool=threads --maxWorkers=1 --minWorkers=1",
    "test:ssr": "vitest run src/__tests__/release-blockers.test.tsx src/hooks/__tests__/advanced-features.test.tsx -t \"SSR|server\"",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "bench:release": "NEO_BENCHMARK_SMOKE=1 vitest bench --run test/benchmarks/release-gate.bench.ts --pool=forks --maxWorkers=1 --minWorkers=1",
    "typecheck": "lpm run typecheck:source typecheck:public typecheck:tests typecheck:benchmarks",
    "typecheck:source": "tsc --noEmit",
    "typecheck:public": "tsc -p tsconfig.type-tests.json",
    "typecheck:package": "tsc -p tsconfig.package-tests.json && tsc -p tsconfig.package-cjs-tests.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "typecheck:benchmarks": "tsc -p tsconfig.benchmarks.json",
    "clean": "rm -rf dist",
    "test:package": "node test/package-smoke.mjs && node test/package-smoke.cjs",
    "release:check": "lpm run clean && lpm run typecheck && lpm run test:coverage && lpm run test:ssr && lpm run test:memory && lpm run build && lpm run typecheck:package && lpm run test:package && lpm run bench:release",
    "prepublishOnly": "lpm run release:check"
  },
  "keywords": [
    "react",
    "forms",
    "hooks",
    "validation",
    "typescript",
    "performance",
    "tree-shakeable",
    "formik",
    "react-hook-form",
    "zero-dependency",
    "lpm"
  ],
  "author": "neo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ne-ooo/neo.react-forms"
  },
  "bugs": {
    "url": "https://github.com/ne-ooo/neo.react-forms/issues"
  },
  "homepage": "https://github.com/ne-ooo/neo.react-forms#readme",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "zod": "^3.25.76"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^1.2.0",
    "formik": "^2.4.9",
    "happy-dom": "^15.11.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.71.1",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
